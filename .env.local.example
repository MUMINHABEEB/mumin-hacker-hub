# MongoDB Configuration (server-side — set in Netlify dashboard, not in .env for frontend)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Auth (server-side — set in Netlify dashboard)
# JWT_SECRET=your-random-secret-at-least-32-chars
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD_HASH=<bcrypt hash generated via: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)">

# EmailJS Configuration
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-template-id

# OpenRouter AI Configuration
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
VITE_SITE_URL=https://your-site-url.com
VITE_SITE_TITLE=Your Site Title